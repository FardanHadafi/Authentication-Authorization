# Database Configuration (PostgreSQL 18.7)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth_db
POSTGRES_PORT=5432

# Connection string for Host / Goose Migrations
DB_URL="postgres://postgres:postgres@localhost:5432/auth_db?sslmode=disable"

# Redis Configuration (Redis 8.10.3)
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"
REDIS_ADDR=localhost:6379

# API Configuration
API_PORT=8080
APP_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Mailpit / SMTP Configuration
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
